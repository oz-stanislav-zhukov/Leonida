+       "vphaddbw", "vphaddbd", "vphaddbq", "vphaddwd", "vphaddwq", "vphadddq", "vphaddubw", "vphaddubd",
+       "vphaddubq", "vphadduwd", "vphadduwq", "vphaddudq", "vphsubbw", "vphsubwd", "vphsubdq", "vpmacssww",
